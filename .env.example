# Copy to .env and fill in values. Never commit .env to git.

# Required for production - generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# Database - Railway provides DATABASE_URL when you add PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/aigymbuddy

# CORS - comma-separated allowed origins (your frontend URL)
# After Railway deploy, add: https://yourapp.up.railway.app
# For Flutter web on same domain, use your app URL
CORS_ORIGINS=https://your-frontend.railway.app

# Debug - set to true only for local dev (enables debug endpoints)
DEBUG=false
